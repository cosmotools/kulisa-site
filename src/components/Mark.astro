---
// The app's icon (kulisa/assets/icon.svg): a stage curtain drawn apart, the agent's pointer on stage.
// Cropped to its rounded square; the same drawing is public/favicon.svg.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="100 100 824 824" aria-hidden="true">
  <defs>
    <linearGradient id="mark-drape" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7d1820"/><stop offset=".3" stop-color="#c8333b"/><stop offset=".55" stop-color="#8f1d25"/>
      <stop offset=".8" stop-color="#d23c44"/><stop offset="1" stop-color="#7d1820"/>
    </linearGradient>
    <clipPath id="mark-body"><rect x="100" y="100" width="824" height="824" rx="185"/></clipPath>
  </defs>
  <g clip-path="url(#mark-body)">
    <rect x="100" y="100" width="824" height="824" fill="#17181b"/>
    <path d="M100 100 H466 C438 390 374 630 318 924 H100 Z" fill="url(#mark-drape)"/>
    <path d="M924 100 H558 C586 390 650 630 706 924 H924 Z" fill="url(#mark-drape)"/>
  </g>
  <path d="M446 390 L446 740 L529 659 L584 777 L641 751 L586 635 L700 629 Z" fill="#ffd27a" stroke="#17181b" stroke-width="26" stroke-linejoin="round"/>
</svg>
