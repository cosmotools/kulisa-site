---
// Stands in for the window screenshot until a real one is set in src/content/site.ts (hero.media.image).
interface Props { label: string }
const { label } = Astro.props;
const panes = [
  { name: 'Sam', role: 'seller', color: '#e5534b', url: 'shop.example/orders' },
  { name: 'Elon', role: 'buyer', color: '#57ab5a', url: 'shop.example/cart' },
  { name: 'Kim', role: 'admin', color: '#539bf5', url: 'shop.example/admin' },
];
---
<div class="win" role="img" aria-label={label}>
  <div class="win-bar">
    <span class="win-title">Kulisa — Shop</span>
    <span class="win-tag">Illustration</span>
  </div>
  <div class="win-panes">
    {panes.map((p, i) => (
      <div class="pane" style={`--c:${p.color}`}>
        <div class="pane-head">
          <span class="dot"></span><span class="who">{p.name}</span><span class="role">· {p.role}</span>
          {i === 1 && <span class="caption">click “Checkout”</span>}
        </div>
        <div class="pane-url">{p.url}</div>
        <div class="page">
          {i === 0 && (
            <>
              <div class="bar w60"></div>
              <div class="card hl"><span>Order #12</span><span class="badge">NEW</span></div>
              <div class="card"><span>Order #11</span></div>
              <div class="card"><span>Order #10</span></div>
              <div class="bar w40"></div>
              <div class="bar w60"></div>
            </>
          )}
          {i === 1 && (
            <>
              <div class="bar w50"></div>
              <div class="row"><span class="thumb"></span><div class="bar w60"></div></div>
              <div class="row"><span class="thumb"></span><div class="bar w40"></div></div>
              <div class="row"><span class="thumb"></span><div class="bar w50"></div></div>
              <div class="bar w40"></div>
              <div class="btn act">Checkout<span class="ping"></span></div>
            </>
          )}
          {i === 2 && (
            <>
              <div class="bar w40"></div>
              <div class="table">{Array.from({ length: 7 }, () => <div class="tr"><i></i><i></i><i></i></div>)}</div>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
  <div class="term">
    <div><span class="pr">$</span> claude</div>
    <div class="out">&gt; Elon pays for order #12, then I check that Sam sees it…</div>
  </div>
</div>

<style>
  /* Always dark, like the app. */
  .win {
    --w: #0f1011; --i: #232528; --ih: #33363b; --t: #e8e8e8; --m: #8b8f96;
    background: var(--w); color: var(--t);
    border-radius: 14px; padding: 0 8px 8px;
    font-size: 11px; line-height: 1.3;
    box-shadow: var(--shadow-hero);
    aspect-ratio: 16 / 9;
    display: grid; grid-template-rows: auto 1fr auto; gap: 8px;
    overflow: hidden; text-align: left;
  }
  .win-bar { display: flex; align-items: center; justify-content: space-between; height: 30px; padding: 0 6px; color: var(--m); }
  .win-tag { border: 1px solid var(--ih); border-radius: 999px; padding: 1px 8px; font-size: 10px; }
  .win-panes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; min-height: 0; }
  .pane { background: var(--i); border-radius: 10px; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
  .pane-head { display: flex; align-items: center; gap: 5px; padding: 7px 9px; white-space: nowrap; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c); flex: none; }
  .who { font-weight: 600; }
  .role { color: var(--m); }
  .caption {
    margin-left: auto; padding: 1px 6px; border-radius: 4px; font-size: 10px;
    background: color-mix(in srgb, var(--c) 25%, transparent); color: var(--t);
    overflow: hidden; text-overflow: ellipsis;
  }
  .pane-url { margin: 0 8px; padding: 3px 7px; border-radius: 5px; background: var(--w); color: var(--m); font-size: 10px; white-space: nowrap; overflow: hidden; }
  .page { flex: 1; margin: 8px; border-radius: 6px; background: #fbfbfa; padding: 10px; display: flex; flex-direction: column; gap: 8px; color: #333; }
  .bar { height: 7px; border-radius: 4px; background: #e3e3e0; }
  .w40 { width: 40%; } .w50 { width: 50%; } .w60 { width: 60%; }
  .card { display: flex; justify-content: space-between; align-items: center; border: 1px solid #e3e3e0; border-radius: 6px; padding: 7px 8px; }
  .card.hl { outline: 2px solid var(--c); outline-offset: 2px; }
  .badge { background: #e5534b; color: #fff; font-size: 9px; font-weight: 700; padding: 1px 5px; border-radius: 4px; }
  .row { display: flex; gap: 8px; align-items: center; }
  .thumb { width: 22px; height: 22px; border-radius: 4px; background: #e3e3e0; flex: none; }
  .row .bar { flex: 1; }
  .btn { align-self: flex-start; position: relative; background: #2b2d31; color: #fff; padding: 6px 12px; border-radius: 6px; font-weight: 600; margin-top: auto; }
  .btn.act { outline: 2px solid var(--c); outline-offset: 2px; }
  .ping { position: absolute; right: -5px; bottom: -5px; width: 12px; height: 12px; border-radius: 50%; background: var(--c); border: 2px solid #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .ping { animation: ping 2.4s ease-out infinite; }
    @keyframes ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 60%, transparent); } 70%, 100% { box-shadow: 0 0 0 12px transparent; } }
  }
  .table { display: flex; flex-direction: column; gap: 6px; }
  .tr { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 6px; }
  .tr i { height: 7px; border-radius: 4px; background: #e3e3e0; }
  .term { background: var(--i); border-radius: 10px; padding: 9px 11px; font-family: var(--mono); font-size: 10.5px; display: grid; gap: 3px; }
  .term .pr { color: #57ab5a; }
  .term .out { color: var(--m); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  @media (max-width: 640px) {
    .win { font-size: 9px; aspect-ratio: 4 / 3.4; }
    .win-panes { grid-template-columns: repeat(2, 1fr); }
    .pane:nth-child(3) { display: none; }
    .caption { display: none; }
  }
</style>
