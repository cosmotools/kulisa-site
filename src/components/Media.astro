---
// A 16:9 media slot: a video, an image, or (until either exists) a calm placeholder of the same size.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Media, Icon as IconName } from '../content/site';
import Icon from './Icon.astro';

interface Props { media: Media; icon?: IconName; eager?: boolean; sizes?: string }
const { media, icon, eager = false, sizes = '(min-width: 1100px) 560px, 100vw' } = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const asset = (file?: string) => {
  if (!file) return undefined;
  const found = assets[`../assets/${file}`];
  if (!found) throw new Error(`Media: src/assets/${file} not found`);
  return found.default;
};

const image = asset(media.image);
const posterAsset = asset(media.poster);
const poster = posterAsset ? (await getImage({ src: posterAsset, width: 1280, format: 'webp' })).src : undefined;
---
<div class="media" data-kind={media.video ? 'video' : image ? 'image' : 'empty'}>
  {media.video ? (
    <video muted loop playsinline preload="none" poster={poster} aria-label={media.alt} data-lazy-video>
      <source src={`/media/${media.video}`} type={media.video.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
    </video>
  ) : image ? (
    <Image src={image} alt={media.alt ?? ''} widths={[640, 960, 1280, 1920]} sizes={sizes}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  ) : (
    <slot>
      <div class="media-empty" aria-hidden="true">
        {icon && <span class="media-empty-icon"><Icon name={icon} size={40} /></span>}
      </div>
    </slot>
  )}
</div>

<style>
  .media {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .media video, .media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .media-empty {
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 80% at 50% 110%, var(--glow), transparent 70%),
      repeating-linear-gradient(90deg, transparent 0 calc(25% - 1px), var(--line-soft) calc(25% - 1px) 25%);
  }
  .media-empty-icon {
    display: grid;
    place-items: center;
    width: 76px; height: 76px;
    border-radius: 50%;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
  }
</style>

<script>
  // Play videos while visible; with reduced motion, never autoplay: show controls instead.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
  if (reduce.matches) {
    videos.forEach((v) => { v.controls = true; v.preload = 'metadata'; });
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => { v.controls = true; });
        else v.pause();
      }
    }, { rootMargin: '200px' });
    videos.forEach((v) => io.observe(v));
  }
</script>
