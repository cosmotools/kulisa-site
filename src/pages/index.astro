---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import Downloads from '../components/Downloads.astro';
import { hero, problem, steps, features, more, later, faq, forDevelopers, links, logo } from '../content/site';

const year = new Date().getFullYear();
---
<Base>
  <header class="top wrap">
    <a class="wordmark" href="/" aria-label="Kulisa, home">
      {logo.mark && <Mark size={32} />}<span>Kulisa</span>
    </a>
    <nav aria-label="Sections">
      <a href="#how">How it works</a>
      <a href="#features">Features</a>
      <a href="#faq">FAQ</a>
      <a class="gh" href={links.repo} aria-label="Kulisa on GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        <span>GitHub</span>
      </a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <div class="hero-text">
          <h1>{hero.pitch}</h1>
          <p class="hero-sub">{hero.sub}</p>
          <Downloads />
        </div>
      </div>
      <div class="hero-media">
        <Media media={hero.media} eager sizes="(min-width: 1280px) 1240px, 100vw" />
      </div>
    </section>

    <section class="problem" aria-labelledby="problem-title">
      <div class="wrap">
        <span class="eyebrow">The problem</span>
        <h2 id="problem-title" class="section-title">{problem.title}</h2>
        <p class="lead">{problem.text}</p>
        <ul class="points">
          {problem.points.map((p) => (
            <li><h3>{p.title}</h3><p>{p.text}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="how" class="how" aria-labelledby="how-title">
      <div class="wrap">
        <span class="eyebrow">How it works</span>
        <h2 id="how-title" class="section-title">Set the stage once. Then watch.</h2>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <span class="step-label">{s.label}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="features" class="features" aria-labelledby="features-title">
      <div class="wrap">
        <span class="eyebrow">Features</span>
        <h2 id="features-title" class="section-title">What Kulisa does today</h2>
        <div class="feature-list">
          {features.map((f) => (
            <article class:list={['feature', { wide: f.wide }]} id={f.id}>
              <div class="feature-text">
                <span class="feature-icon"><Icon name={f.icon} /></span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
              <Media media={f} icon={f.icon} sizes={f.wide ? '(min-width: 1120px) 1080px, 100vw' : undefined} />
            </article>
          ))}
        </div>
        <ul class="more">
          {more.map((f) => (
            <li>
              <span class="feature-icon"><Icon name={f.icon} /></span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="later" aria-labelledby="later-title">
      <div class="wrap">
        <span class="eyebrow">Coming later</span>
        <h2 id="later-title" class="section-title">Next on stage</h2>
        <ul class="later-list">
          {later.map((f) => (
            <li>
              <span class="feature-icon"><Icon name={f.icon} /></span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq" aria-labelledby="faq-title">
      <div class="wrap narrow">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title" class="section-title">Questions</h2>
        <div class="qa">
          {faq.map((item) => (
            <details>
              <summary><h3>{item.q}</h3></summary>
              <p set:html={item.a} />
            </details>
          ))}
          <details>
            <summary><h3>For developers: how does it work?</h3></summary>
            <ul class="dev">
              {forDevelopers.map((line) => <li set:html={line} />)}
            </ul>
          </details>
        </div>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <div class="wrap">
        <h2 id="cta-title" class="section-title">Everyone on one stage.</h2>
        <Downloads />
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <p>© {year} cosmotools · <a href={links.github}>GitHub</a></p>
      <p class="name-note"><i lang="ru">Кулиса</i> is Russian for the wings of a theatre stage.</p>
    </div>
  </footer>
</Base>

<style>
  .top { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.2rem; letter-spacing: -0.01em; color: var(--text); text-decoration: none; }
  .top nav { display: flex; gap: 24px; }
  .top nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  .top nav a:hover { color: var(--text); }
  .top nav .gh { display: inline-flex; align-items: center; gap: 6px; }
  @media (max-width: 640px) {
    .top nav a:not(.gh) { display: none; }
    .top nav .gh span { display: none; }
  }

  .hero { padding-top: 48px; text-align: center; overflow: hidden; }
  .hero-text { max-width: 780px; margin: 0 auto; }
  .hero h1 { font-size: clamp(2.3rem, 6vw, 4rem); letter-spacing: -0.035em; }
  .hero-sub { color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.25rem); margin: 20px auto 32px; max-width: 36em; }
  .hero-media { margin: 56px auto 0; width: min(1240px, 100% - 40px); position: relative; }
  .hero-media :global(.media) { border: 0; border-radius: 10px; background: none; box-shadow: var(--shadow-hero); }
  .hero-media::before {
    content: ''; position: absolute; inset: 10% -10% -20%; z-index: -1;
    background: radial-gradient(closest-side, var(--glow), transparent);
  }

  .problem { background: var(--surface-2); }
  .points { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .points li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .points h3, .steps h3, .later-list h3, .more h3 { font-size: 1.1rem; margin-bottom: 8px; }
  .points p, .steps p, .later-list p, .more p { color: var(--muted); font-size: 1rem; }

  .steps { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .steps li { position: relative; padding-top: 20px; border-top: 1px solid var(--line); }
  .step-num {
    display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
    background: var(--text); color: var(--bg); font-weight: 700; font-size: 0.85rem; margin-right: 10px;
  }
  .step-label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .steps h3 { margin-top: 16px; }

  .features { border-top: 1px solid var(--line); }
  .feature-list { display: grid; gap: 72px; margin-top: 56px; }
  .feature { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; align-items: center; scroll-margin-top: 24px; }
  .feature:nth-child(even) { grid-template-columns: 7fr 5fr; }
  .feature:nth-child(even) .feature-text { order: 2; }
  .feature.wide { grid-template-columns: 1fr; gap: 32px; }
  .feature.wide .feature-text { order: 0; max-width: 680px; margin: 0 auto; text-align: center; }
  .feature h3 { font-size: 1.5rem; margin: 16px 0 12px; }
  .feature p { color: var(--muted); }
  .feature-icon {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px;
    background: var(--surface); border: 1px solid var(--line); color: var(--text);
  }

  .more { list-style: none; padding: 0; margin: 88px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .more li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .more h3 { margin-top: 16px; }

  .later { background: var(--surface-2); }
  .later-list { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
  .later-list li { background: var(--surface); border: 1px dashed var(--line); border-radius: var(--radius); padding: 24px; }
  .later-list h3 { margin-top: 16px; }

  .narrow { max-width: 780px; }
  .qa { margin-top: 32px; border-top: 1px solid var(--line); }
  .qa details { border-bottom: 1px solid var(--line); }
  .qa summary { list-style: none; cursor: pointer; padding: 20px 36px 20px 0; position: relative; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary::after {
    content: ''; position: absolute; right: 6px; top: 50%; width: 9px; height: 9px; margin-top: -7px;
    border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(45deg); transition: transform .2s;
  }
  .qa details[open] summary::after { transform: rotate(225deg); margin-top: -2px; }
  .qa summary h3 { font-size: 1.1rem; font-weight: 600; letter-spacing: -0.01em; }
  .qa details > p, .qa .dev { color: var(--muted); padding: 0 0 24px; margin: 0; }
  .qa .dev { padding-left: 1.2em; display: grid; gap: 8px; font-size: 0.97rem; }

  .cta { text-align: center; border-top: 1px solid var(--line); }
  .cta h2 { margin-bottom: 28px; }

  .foot { border-top: 1px solid var(--line); padding: 32px 0 40px; color: var(--muted); font-size: 0.92rem; }
  .foot .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
  .foot a { color: var(--muted); }
  .foot a:hover { color: var(--text); }

  @media (max-width: 900px) {
    .points, .steps, .more { grid-template-columns: 1fr; }
    .later-list { grid-template-columns: repeat(2, 1fr); }
    .feature, .feature:nth-child(even) { grid-template-columns: 1fr; gap: 24px; }
    .feature:nth-child(even) .feature-text { order: 0; }
  }
  @media (max-width: 560px) {
    .later-list { grid-template-columns: 1fr; }
    .feature-list { gap: 56px; }
  }
</style>
