---
import '../styles/global.css';
import { meta } from '../content/site';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = meta.title, description = meta.description, noindex = false } = Astro.props;

// Pages are built as files (docs.html), served without the extension: /docs.
const url = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Structured data for search engines: what the app is, where it runs, that it is free.
const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kulisa',
  description: meta.description,
  url: Astro.site?.href,
  image: ogImage.href,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows, Linux',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'cosmotools' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1011" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kulisa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kulisa: several people’s browsers side by side in one window." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(app)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
